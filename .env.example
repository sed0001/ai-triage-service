# LLM (ProxyAPI, OpenAI-совместимый эндпоинт)
LLM_API_KEY=
LLM_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# Лимит запросов на client_id
RATE_LIMIT_PER_MINUTE=5

# Ограничения контракта
MAX_TEXT_LENGTH=2000
MAX_CLIENT_ID_LENGTH=128

# Пути
DB_PATH=data/tickets.db
LOG_DIR=logs
KNOWLEDGE_BASE_PATH=examples/knowledge_base.json

# Запуск
APP_HOST=0.0.0.0
APP_PORT=8000

# Только для docker-compose (Caddy)
CADDY_DOMAIN=localhost
